# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Placeholder - update with your actual MongoDB connection string)
MONGODB_URI=mongodb://localhost:27017/foodieexpress
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/foodieexpress?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_foodie_express_production_2026
JWT_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=your_cookie_secret_foodie_express_auth_session

# Client / CORS Origin
FRONTEND_URL=http://localhost:5173
